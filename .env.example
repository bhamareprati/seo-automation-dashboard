# Copy to .env and fill in. Never commit .env.

# Database (Neon). Pooled URL for the app, direct URL for prisma db push.
# "neon env pull" writes DATABASE_URL and DATABASE_URL_UNPOOLED. The spec's schema reads
# the direct URL as DIRECT_URL, so copy DATABASE_URL_UNPOOLED's value into DIRECT_URL.
# Add connect_timeout=15 to both, and pool_timeout=20 to DATABASE_URL, because a first
# connection to a sleeping database can be slow.
DATABASE_URL=
DIRECT_URL=

# Queue (Upstash Redis). Must be a rediss:// URL.
REDIS_URL=

# true = all external integrations use mock data. false = real integrations.
USE_MOCKS=true

# Claude. With USE_MOCKS=true, leaving the key empty uses the sample analysis.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
MAX_REAL_AI_AUDITS_PER_DAY=20

# At least 32 random characters each:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
SESSION_SECRET=

# Sign-in. Hashes are bcrypt, then base64-encoded, because bcrypt hashes contain "$".
ADMIN_EMAIL=admin@demo.test
ADMIN_PASSWORD_HASH=
CLIENT_PASSWORD_HASH=

# Production URL, or http://localhost:3000 locally.
APP_URL=http://localhost:3000

# Optional. Defaults shown.
# REPORTS_DIR=<system temp folder>/reports
# AUDIT_INTERVAL_DAYS=30
# CRAWL_TOTAL_BUDGET_MS=30000
# CRAWL_REQUEST_TIMEOUT_MS=10000
# MOCK_STEP_DELAY_MS=800

# Local development only: path to an installed Chrome, used to render PDFs.
# CHROME_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Test database for npm run test:integration. Never point this at production.
# TEST_DATABASE_URL=

# Real integrations, needed only when USE_MOCKS=false. Names only.
# PAGESPEED_API_KEY=
# GSC_CLIENT_ID=
# GSC_CLIENT_SECRET=
# GSC_REFRESH_TOKEN=
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
# EMAIL_API_KEY=
# EMAIL_FROM=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
